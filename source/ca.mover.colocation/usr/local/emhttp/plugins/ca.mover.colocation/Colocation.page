<?PHP
$plugin      = 'ca.mover.colocation';
$cfg_dir     = "/boot/config/plugins/{$plugin}";
$cfg_file    = "{$cfg_dir}/{$plugin}.cfg";
$rules_file  = "{$cfg_dir}/colocation_rules.cfg";
$script_path = "/usr/local/emhttp/plugins/{$plugin}/colocation_prep";
$mover_cfg   = '/boot/config/plugins/ca.mover.tuning/ca.mover.tuning.cfg';

$cfg             = @parse_ini_file($cfg_file) ?: [];
$colocateEnabled = ($cfg['colocateEnabled'] ?? 'no') === 'yes' ? 'yes' : 'no';
$logEnabled      = ($cfg['logEnabled']      ?? 'yes') === 'yes' ? 'yes' : 'no';
$rules_text      = file_exists($rules_file) ? file_get_contents($rules_file) : '';

$mover_tuning_installed  = file_exists('/usr/local/emhttp/plugins/ca.mover.tuning/age_mover');
$mover_tuning_cfg_exists = file_exists($mover_cfg);
$configured_before = '';
if ($mover_tuning_cfg_exists) {
    $mt_cfg            = @parse_ini_file($mover_cfg) ?: [];
    $configured_before = $mt_cfg['beforeScript'] ?? '';
}
$is_before_script_set   = ($configured_before === $script_path);
$before_script_conflict = !empty($configured_before) && !$is_before_script_set;

$log_file    = '/tmp/ca.mover.colocation/colocation_prep.log';
$log_content = '';
if (file_exists($log_file)) {
    $lines       = file($log_file);
    $log_content = htmlspecialchars(implode('', array_slice($lines, -40)));
}
?>

<script>
function saveColocationSettings() {
    var btn = document.getElementById('colocSaveBtn');
    var status = document.getElementById('colocSaveStatus');
    btn.disabled = true;
    status.innerHTML = 'Saving&hellip;';
    status.style.color = '';
    $.post('/plugins/ca.mover.colocation/save_colocation.php', {
        colocateEnabled: $('#colocateEnabled').val(),
        logEnabled:      $('#logEnabled').val(),
        rules:           $('#colocationRules').val()
    })
    .done(function(resp) {
        if (resp.trim() === 'OK') {
            status.textContent = 'Saved.';
            status.style.color = 'green';
        } else {
            status.textContent = 'Error: ' + resp;
            status.style.color = 'red';
        }
    })
    .fail(function() {
        status.textContent = 'Request failed.';
        status.style.color = 'red';
    })
    .always(function() { btn.disabled = false; });
    return false;
}
function setBeforeScript() {
    var s = document.getElementById('colocIntegStatus');
    $.post('/plugins/ca.mover.colocation/save_colocation.php', {action:'set_before_script'})
    .done(function(r){ if(r.trim()==='OK'){location.reload();}else{s.textContent='Error: '+r;s.style.color='red';} });
}
function clearBeforeScript() {
    var s = document.getElementById('colocIntegStatus');
    $.post('/plugins/ca.mover.colocation/save_colocation.php', {action:'clear_before_script'})
    .done(function(r){ if(r.trim()==='OK'){location.reload();}else{s.textContent='Error: '+r;s.style.color='red';} });
}
</script>

<?if (!$mover_tuning_installed):?>
<p class='notice'>CA Mover Tuning is not installed. Please install it before using this plugin.</p>
<?endif;?>

<form onsubmit="return saveColocationSettings();">

**Enable Colocation:**
: <select name='colocateEnabled' id='colocateEnabled' size='1'>
  <option value='yes' <?=($colocateEnabled==='yes'?'selected':'')?>><?=_('Yes')?></option>
  <option value='no'  <?=($colocateEnabled==='no' ?'selected':'')?>><?=_('No')?></option>
  </select>
> Pre-creates directories on the target disk before CA Mover Tuning runs.

**Enable Logging:**
: <select name='logEnabled' id='logEnabled' size='1'>
  <option value='yes' <?=($logEnabled==='yes'?'selected':'')?>><?=_('Yes')?></option>
  <option value='no'  <?=($logEnabled==='no' ?'selected':'')?>><?=_('No')?></option>
  </select>
> Log: /tmp/ca.mover.colocation/colocation_prep.log

**Integration Status:**
: <span id='colocIntegStatus'><?php
  if ($is_before_script_set) {
      echo "<span style='color:green;'>&#10003; Configured</span> &mdash; Before Script is set correctly. ";
      echo "<button type='button' onclick='clearBeforeScript()'>Remove</button>";
  } elseif ($before_script_conflict) {
      echo "<span style='color:orange;'>&#9888; Conflict</span> &mdash; Before Script already set to:<br>";
      echo "<code>".htmlspecialchars($configured_before)."</code><br>";
      echo "Add <code>".htmlspecialchars($script_path)."</code> to that script manually.";
  } elseif (!$mover_tuning_cfg_exists) {
      echo "<span style='color:red;'>&#10005; CA Mover Tuning config not found.</span>";
  } else {
      echo "<span style='color:red;'>&#10005; Not configured.</span> ";
      echo "<button type='button' onclick='setBeforeScript()'>Configure</button>";
  }
  ?></span>

**Colocation Rules:**
: <textarea id='colocationRules' name='rules' rows='16' style='width:100%;font-family:monospace;font-size:13px;'><?=htmlspecialchars($rules_text)?></textarea>
> Format: SHARE|SUBPATH|DEPTH &mdash; one rule per line, # = comment
> Depth 0: whole SUBPATH on one disk. &nbsp; Depth 1: each subfolder on its own disk.

: <input type='submit' id='colocSaveBtn' value='Apply'>&nbsp;&nbsp;<span id='colocSaveStatus'></span>

</form>

<?if ($log_content):?>

**Last Run Log:**
: <pre style='background:#111;color:#ddd;padding:10px;font-size:12px;max-height:300px;overflow:auto;'><?=$log_content?></pre>

<?endif;?>
