<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN [
  <!ENTITY name      "ca.mover.colocation">
  <!ENTITY author    "adman234">
  <!ENTITY version   "2026.04.18">
  <!ENTITY pluginURL "https://raw.githubusercontent.com/adman234/ca.mover.colocation/master/ca.mover.colocation.plg">
  <!ENTITY pkgURL    "https://github.com/adman234/ca.mover.colocation/releases/download/&version;/ca.mover.colocation-&version;.txz">
  <!ENTITY md5       "9b7c23d5ce8b4138ae247a63660ff0dc">
]>

<PLUGIN  name="&name;"
         author="&author;"
         version="&version;"
         pluginURL="&pluginURL;"
         support="https://github.com/adman234/ca.mover.colocation/issues"
         min="6.9.0">

<CHANGES>
###2026.04.18
- Fix disk cache bug: get_target_disk was called via $() subshell, so cache
  writes were discarded on every call — causing one disk scan per file instead
  of one per unique anchor. Now uses a global result variable to avoid subshell.
  Log will now show each anchor decision once instead of once per file.

###2026.04.17
- Fix UI: add markdown="1" to form tag — without it Unraid's page processor
  does not parse label/value/description syntax inside form blocks at all
- Fix UI: change label syntax from **Label:** to plain Label: (correct Unraid format)
- Apply button now uses type=button onclick instead of form submit

###2026.04.16
- Fix CRLF line endings in package; shorten description lines

###2026.04.15
- Initial release
- Folder colocation for CA Mover Tuning
- Generic rules system: any share, any sub-path, configurable anchor depth
- Integrates as a Before Script for CA Mover Tuning
- Settings page in Scheduler section alongside CA Mover Tuning
</CHANGES>

<!--
  Pre-install check: Unraid version and CA Mover Tuning presence.
  Note: avoid bare < in PHP here — use !version_compare(...,'>=') instead.
-->
<FILE Run="/usr/bin/php">
<INLINE>
<?php
$mover_tuning = '/usr/local/emhttp/plugins/ca.mover.tuning/age_mover';
if (!file_exists($mover_tuning)) {
    echo "CA Mover Tuning is not installed.\n";
    echo "Please install CA Mover Tuning first, then install this plugin.\n";
    exit(1);
}
$unraid_ver = trim(shell_exec("grep '^version=' /etc/unraid-version | cut -d'\"' -f2") ?: '0.0.0');
if (!version_compare($unraid_ver, '6.9.0', '>=')) {
    echo "This plugin requires Unraid 6.9.0 or later (detected: $unraid_ver).\n";
    exit(1);
}
echo "Pre-install checks passed.\n";
?>
</INLINE>
</FILE>

<!--
  Download and install the plugin package.
-->
<FILE Name="/boot/config/plugins/&name;/&name;-&version;.txz" Run="upgradepkg --install-new">
<URL>&pkgURL;</URL>
<MD5>&md5;</MD5>
</FILE>

<!--
  Post-install setup.
  Note: no heredocs or file-redirect operators ( no bare < ) in this block.
-->
<FILE Run="/bin/bash">
<INLINE>
PLUGIN="ca.mover.colocation"
CFG_DIR="/boot/config/plugins/${PLUGIN}"
CFG_FILE="${CFG_DIR}/${PLUGIN}.cfg"
DEFAULT_CFG="/usr/local/emhttp/plugins/${PLUGIN}/default.cfg"
RULES_DEFAULT="/usr/local/emhttp/plugins/${PLUGIN}/colocation_rules.cfg.default"
RULES_FILE="${CFG_DIR}/colocation_rules.cfg"
SCRIPT_PATH="/usr/local/emhttp/plugins/${PLUGIN}/colocation_prep"
MOVER_TUNING_CFG="/boot/config/plugins/ca.mover.tuning/ca.mover.tuning.cfg"

# Ensure boot-drive config directory exists
mkdir -p "${CFG_DIR}"

# Initialise config from defaults if not already present
if [ ! -f "${CFG_FILE}" ]; then
    cp "${DEFAULT_CFG}" "${CFG_FILE}"
fi

# Create a starter rules file if none exists
if [ ! -f "${RULES_FILE}" ]; then
    if [ -f "${RULES_DEFAULT}" ]; then
        cp "${RULES_DEFAULT}" "${RULES_FILE}"
    fi
fi

# Make the before-script executable
chmod +x "${SCRIPT_PATH}"

# Auto-configure CA Mover Tuning Before Script if the field is currently empty
if [ -f "${MOVER_TUNING_CFG}" ]; then
    current_before=$(grep 'beforeScript=' "${MOVER_TUNING_CFG}" | cut -d'"' -f2)
    if [ -z "${current_before}" ]; then
        sed -i "s|beforeScript=\"\"|beforeScript=\"${SCRIPT_PATH}\"|" "${MOVER_TUNING_CFG}"
        echo "Configured CA Mover Tuning Before Script: ${SCRIPT_PATH}"
    elif [ "${current_before}" = "${SCRIPT_PATH}" ]; then
        echo "CA Mover Tuning Before Script already set correctly."
    else
        echo "NOTE: CA Mover Tuning already has a Before Script: ${current_before}"
        echo "      Use the Colocation settings page to manage the integration."
    fi
fi

echo ""
echo "ca.mover.colocation installed successfully."
echo "Configure your rules at Settings -> Scheduler -> Mover Colocation."
</INLINE>
</FILE>

<!--
  Uninstall / remove script.
-->
<FILE Run="/bin/bash" Method="remove">
<INLINE>
PLUGIN="ca.mover.colocation"
SCRIPT_PATH="/usr/local/emhttp/plugins/${PLUGIN}/colocation_prep"
MOVER_TUNING_CFG="/boot/config/plugins/ca.mover.tuning/ca.mover.tuning.cfg"

# Remove our before-script reference from CA Mover Tuning config
if [ -f "${MOVER_TUNING_CFG}" ]; then
    current_before=$(grep 'beforeScript=' "${MOVER_TUNING_CFG}" | cut -d'"' -f2)
    if [ "${current_before}" = "${SCRIPT_PATH}" ]; then
        sed -i 's|beforeScript="[^"]*"|beforeScript=""|' "${MOVER_TUNING_CFG}"
        echo "Removed colocation Before Script from CA Mover Tuning config."
    fi
fi

# Remove installed package files
removepkg ca.mover.colocation 2>/dev/null

# Remove runtime logs
rm -rf /tmp/ca.mover.colocation

echo "ca.mover.colocation removed."
echo "Rules file kept at /boot/config/plugins/ca.mover.colocation/ for reinstall."
</INLINE>
</FILE>

</PLUGIN>
